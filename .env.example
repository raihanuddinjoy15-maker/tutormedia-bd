# --- Supabase (Database + Auth + Storage) ---
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose to the browser. Used by admin
# routes and payment webhooks that need to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (chatbot + AI tutor matching) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Payments (SSLCommerz — supports bKash/Nagad/Rocket/cards in one integration) ---
# Sandbox (free, instant): https://developer.sslcommerz.com
# Live: requires a registered Bangladeshi business + SSLCommerz merchant approval
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
